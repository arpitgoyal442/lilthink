# Add these in your host's dashboard (Vercel: Project > Settings > Environment Variables). Never commit real values.
RESEND_API_KEY=re_your_key_here
FROM_EMAIL=Lil Think <hello@lilthink.com>
REPLY_TO=hello@lilthink.com
ALLOWED_ORIGINS=https://lilthink.com,https://www.lilthink.com
# Optional: add new subscribers to a Resend segment (for daily broadcasts)
RESEND_SEGMENT_ID=
# Optional: notify n8n on each new subscriber
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
